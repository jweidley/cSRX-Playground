#!/bin/bash
# Purpose: Setup cSRX w/ multiple interfaces with mac vlan and external switch.
# Version: 0.2
# Author: John Weidley
###########################################################################################################
# Notes:
###########################################################################################################

########################################################
# Variables
########################################################
csrxVersion="csrx:25.2R1.9"

########################################################
# Main
########################################################
echo "########################################################"
echo "# cSRX MAC VLAN Demo Topology"
echo "########################################################"

case "$1" in
    "start")
        echo "- Starting cSRX Demo Topology..."
	echo " + Creating mgmt_net bridge..."
        docker network create \
                --driver bridge \
                --subnet=10.0.254.0/24 \
                --gateway=10.0.254.1 \
		--opt com.docker.network.bridge.enable_ip_masquerade=false \
                mgmt_net

	echo " + Creating csrx02-untrust bridge..."
	docker network create \
		--driver bridge \
		--subnet=10.1.0.0/24 \
		--opt com.docker.network.bridge.enable_ip_masquerade=true \
		csrx02-untrust	

	echo " + Creating csrx02-trust bridge..."
	docker network create \
		--driver bridge \
		--subnet=172.16.2.0/24 \
		--opt com.docker.network.bridge.enable_ip_masquerade=false \
		csrx02-trust	

	echo " + Creating csrx02-dmz macvlan..."
	docker network create \
		--driver macvlan \
		--subnet=172.16.21.0/24 \
		--gateway=172.16.21.1 \
		--opt parent=ens4.21 \
		csrx02-dmz	

	echo " + Creating csrx02-noc macvlan..."
	docker network create \
		--driver macvlan \
		--subnet=172.16.22.0/24 \
		--gateway=172.16.22.1 \
		--opt parent=ens4.22 \
		csrx02-noc	

	echo
        echo "- Starting cSRX Container..."
        docker run \
                --name csrx02 \
                --detach \
                --privileged \
                --rm \
                --network mgmt_net \
                --env CSRX_SIZE="CSRX-2CPU-2G" \
                --env CSRX_PORT_NUM=5 \
                --env CSRX_ROOT_PASSWORD=juniper123 \
                --env CSRX_FORWARD_MODE="routing" \
                --volume ./Configs/csrx02-extmacvlan.txt:/root/config.txt \
                ${csrxVersion}

	echo
        echo "- Starting vPC Trust Container..."
	# Privileged is required to change default route/gateway
        docker run \
                --name vpc2 \
                --interactive \
                --tty \
                --detach \
                --rm \
                --privileged \
                --network csrx02-trust \
		--ip 172.16.2.10 \
                alpine:latest \
                ash

        echo "- Starting vPC DMZ Container..."
	# Privileged is required to change default route/gateway
        docker run \
                --name vpc21 \
                --interactive \
                --tty \
                --detach \
                --rm \
                --privileged \
                --network csrx02-dmz \
		--ip 172.16.21.10 \
                alpine:latest \
                ash

	echo
        echo "- Connecting additional networks to cSRX..."
	docker network connect csrx02-trust csrx02
	docker network connect csrx02-untrust csrx02
	docker network connect csrx02-dmz csrx02
	docker network connect csrx02-noc csrx02
	echo

        # Alpine gateway change
        echo "- Configure Gateway on vpcs"
        docker exec vpc2 ip route delete default
        docker exec vpc2 ip route add default via 172.16.2.2 dev eth0
        docker exec vpc21 ip route delete default
        docker exec vpc21 ip route add default via 172.16.21.2 dev eth0

	# Import the configuration from the volume
        echo
        echo "- Importing Device Specific Configuration..."
        sleep 2
        docker exec -it csrx02 /usr/sbin/cli -f /root/config.txt
        sleep 2
	echo "-------------------------------------------------------"

	echo
	echo "Topology Setup Completed! "
        ;;
    "stop")
        echo "- Tearing down cSRX Demo Topology..."
        echo "  + Destroying Containers..."
	docker stop csrx02 vpc2 vpc21

	echo " + Removing bridges..."
	docker network rm mgmt_net csrx02-untrust csrx02-trust csrx02-dmz csrx02-noc

	echo
	echo "Topology Teardown Completed! "
        ;;
    *)
        echo "! ERROR: Must supply an option. Acceptable options are [start|stop]"
        ;;
esac

## End of Script ##
